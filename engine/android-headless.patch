 add_dependencies(gettext_make_pot hintsToPot)
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index c8d882f2..975464e3 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -13,6 +13,30 @@ find_package(libnoise REQUIRED)
 
 add_subdirectory(libslic3r)
 
+if (ORCA_ANDROID_ENGINE_ONLY)
+    # OrcaSlicer.cpp includes wxWidgets and GLFW, including CLI thumbnail code.
+    # This experimental target exposes only libslic3r; it does not build the CLI.
+    set(KEPLER_SLICE_JNI "" CACHE FILEPATH "Optional experimental JNI bridge source")
+    if (KEPLER_SLICE_JNI)
+        if (NOT EXISTS "${KEPLER_SLICE_JNI}")
+            message(FATAL_ERROR "KEPLER_SLICE_JNI does not exist: ${KEPLER_SLICE_JNI}")
+        endif()
+        add_library(kepler_slicer_experimental SHARED "${KEPLER_SLICE_JNI}")
+        get_filename_component(_kepler_jni_dir "${KEPLER_SLICE_JNI}" DIRECTORY)
+        target_sources(kepler_slicer_experimental PRIVATE
+            "${_kepler_jni_dir}/nanosvg_impl.cpp"
+            "${_kepler_jni_dir}/system_profile_config.cpp" "${_kepler_jni_dir}/process_settings.cpp"
+            "${_kepler_jni_dir}/model_io.cpp" "${_kepler_jni_dir}/project_inspector.cpp"
+            "${_kepler_jni_dir}/step_import.cpp" "${_kepler_jni_dir}/color_space_headless.cpp"
+            "${_kepler_jni_dir}/project_settings.cpp" "${_kepler_jni_dir}/project_settings_tests.cpp"
+            "${_kepler_jni_dir}/native_preferences.cpp")
+        target_include_directories(kepler_slicer_experimental PRIVATE
+            "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_SOURCE_DIR}/deps_src/nanosvg")
+        target_link_libraries(kepler_slicer_experimental PRIVATE libslic3r)
+    endif()
+    return()
+endif()
+
 if (SLIC3R_GUI)
     add_subdirectory(glad)
     # imgui, imguizmo, and hidapi are now included from deps_src
diff --git a/src/libslic3r/CMakeLists.txt b/src/libslic3r/CMakeLists.txt
index 034f8b57..996ca217 100644
--- a/src/libslic3r/CMakeLists.txt
+++ b/src/libslic3r/CMakeLists.txt
@@ -625,7 +625,12 @@ cmake_policy(SET CMP0011 NEW)
 # can't reach it; the default opts its Boost lookup into BoostConfig (CMP0167).
 set(CMAKE_POLICY_DEFAULT_CMP0167 NEW)
 find_package(CGAL 6.2 REQUIRED)
-find_package(OpenCV REQUIRED core)
+if (ORCA_ANDROID_ENGINE_ONLY)
+    # The Android dependency build supplies OpenCV as opencv_world, not opencv_core.
+    find_package(OpenCV REQUIRED COMPONENTS world)
+else()
+    find_package(OpenCV REQUIRED core)
+endif()
 find_package(assimp REQUIRED)
 unset(CMAKE_POLICY_DEFAULT_CMP0167)
 cmake_policy(POP)
@@ -665,12 +670,22 @@ endif ()
 # Lets CGAL algorithms given CGAL::Parallel_if_available_tag run on TBB.
 target_compile_definitions(libslic3r_cgal PRIVATE CGAL_LINKED_WITH_TBB)
 target_link_libraries(libslic3r_cgal PRIVATE ${_cgal_tgt} admesh libigl mcut boost_libs TBB::tbb)
+if (ORCA_ANDROID_ENGINE_ONLY)
+    # TextureToColor.cpp also includes CGAL headers directly, so it needs the
+    # target's include directories and dependencies in the cross build.
+    target_link_libraries(libslic3r PRIVATE ${_cgal_tgt})
+endif()
 
 if (MSVC AND "${CMAKE_SIZEOF_VOID_P}" STREQUAL "4") # 32 bit MSVC workaround
     target_compile_definitions(libslic3r_cgal PRIVATE CGAL_DO_NOT_USE_MPZF)
 endif ()
 
-encoding_check(libslic3r)
+if (NOT ORCA_ANDROID_ENGINE_ONLY)
+    # The encoding-check executable is a host tool; the cross-compiled Android
+    # executable cannot run during a Windows-host build. Run source checks on
+    # the host separately for this experimental configuration.
+    encoding_check(libslic3r)
+endif()
 
 target_compile_definitions(libslic3r PUBLIC -DUSE_TBB -DTBB_USE_CAPTURED_EXCEPTION=0)
 # CGAL changes Kd_tree's member layout when TBB is enabled. Match libslic3r_cgal
@@ -683,7 +698,9 @@ target_include_directories(libslic3r PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE
 target_include_directories(libslic3r SYSTEM PUBLIC ${EXPAT_INCLUDE_DIRS})
 
 # Find the OCCT and related libraries
-set(OpenCASCADE_DIR "${CMAKE_PREFIX_PATH}/lib/cmake/occt")
+if (NOT ORCA_ANDROID_ENGINE_ONLY)
+    set(OpenCASCADE_DIR "${CMAKE_PREFIX_PATH}/lib/cmake/occt")
