<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <application
        android:name=".KeplerApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@drawable/ic_launcher"
        android:label="Kepler Slicer"
        android:theme="@style/AppTheme"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true">
        <activity android:name=".NetworkActivity" android:exported="false" />
        <activity android:name=".DeviceActivity" android:exported="false" />
        <provider android:name=".ShareProvider" android:authorities="${applicationId}.share" android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".CloudSyncActivity" android:exported="false" />
        <activity android:name=".CloudPrintLoginActivity" android:exported="false" />
        <activity android:name=".ModelDetailsActivity" android:exported="false" android:enableOnBackInvokedCallback="true" />
        <activity android:name=".PrinterPickerActivity" android:exported="false" android:enableOnBackInvokedCallback="true" />
        <activity android:name=".ProfilePickerActivity" android:exported="false" />
        <activity android:name=".SliceActivity" android:exported="false" />
        <activity android:name=".GcodePreviewActivity" android:exported="false" />
        <activity android:name=".GcodeExportActivity" android:exported="false" />
        <activity android:name=".ProcessSettingsActivity" android:exported="false" android:enableOnBackInvokedCallback="true" />
        <activity android:name=".ImportActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" android:enableOnBackInvokedCallback="true" />
        <activity android:name=".SettingsPresetPickerActivity" android:exported="false" android:enableOnBackInvokedCallback="true" />
        <activity android:name=".SettingsTransferActivity" android:exported="false" android:enableOnBackInvokedCallback="true" />
        <activity android:name=".PreferencesActivity" android:exported="false" android:enableOnBackInvokedCallback="true" />
        <activity android:name=".MainActivity" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".LaunchActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="model/x.stl-binary" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="text/obj" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/vnd.ms-3mfdocument" />
                <data android:mimeType="application/x-3mf" />
                <data android:mimeType="model/step" />
                <data android:mimeType="application/step" />
                <data android:mimeType="application/x-step" />
                <data android:mimeType="model/x-step" />
                <!-- Some document providers expose 3D files as generic binary data.
                     The import path validates the display extension and file contents. -->
                <data android:mimeType="application/octet-stream" />
                <!-- Providers often report model files as binary, ZIP, or plain text.
                     The import route validates the actual filename/type before copying. -->
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="text/obj" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/vnd.ms-3mfdocument" />
                <data android:mimeType="application/x-3mf" />
                <data android:mimeType="model/step" />
                <data android:mimeType="application/step" />
                <data android:mimeType="application/x-step" />
                <data android:mimeType="model/x-step" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
