<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F7F5</item>
        <item name="android:navigationBarColor">#F7F7F5</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#20201E</item>
        <item name="android:windowBackground">#F7F7F5</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="AppThemeDarkBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#111311</item>
        <item name="android:navigationBarColor">#111311</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#D0D4CC</item>
        <item name="android:windowBackground">#111311</item>
    </style>
    <style name="AppThemeDark" parent="AppThemeDarkBase" />
    <style name="KeplerAlertDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#E4E6DF</item>
        <item name="android:colorBackgroundFloating">#1C1E1C</item>
        <item name="android:windowBackground">@drawable/dialog_dark</item>
    </style>
    <style name="KeplerAlertLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1B1C1B</item>
        <item name="android:colorBackgroundFloating">#EFF0EC</item>
        <item name="android:windowBackground">@drawable/dialog_light</item>
    </style>
</resources>
